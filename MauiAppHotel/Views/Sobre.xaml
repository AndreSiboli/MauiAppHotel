<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray950}">

    <ScrollView>
        <VerticalStackLayout Padding="25"
                             Spacing="25"
                             VerticalOptions="Center">

            <VerticalStackLayout Spacing="5">

                <Label Text="Sobre"
                       FontFamily="Kalam"
                       FontSize="45"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray100}"/>

                <Label Text="Conheça um pouco sobre o aplicativo"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Gray300}"/>

            </VerticalStackLayout>

            <Border Padding="25"
                    Stroke="{StaticResource Gray600Brush}"
                    StrokeThickness="1"
                    Background="{StaticResource Gray900Brush}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Label Text="🏨"
                           FontSize="55"
                           HorizontalOptions="Center"/>

                    <Label Text="MauiAppHotel"
                           FontSize="25"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray100}"/>

                    <Label Text="Aplicativo desenvolvido para facilitar a contratação de hospedagens, permitindo selecionar acomodações, informar hóspedes e consultar o período da estadia."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Gray300}"/>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray600}"/>

                    <VerticalStackLayout Spacing="6">

                        <Label Text="Desenvolvedor"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray300}"/>

                        <Label Text="André"
                               FontSize="19"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray100}"/>

                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">

                        <Label Text="Ano de desenvolvimento"
                               FontSize="14"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray300}"/>

                        <Label Text="2026"
                               FontSize="17"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource Gray100}"/>

                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray600}"/>

                    <Label Text="Desenvolvido com .NET MAUI"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Gray400}"/>

                </VerticalStackLayout>

            </Border>

            <Button Text="Voltar"
                    BackgroundColor="{StaticResource Gray100}"
                    TextColor="{StaticResource Gray950}"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="BtnVoltar_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
